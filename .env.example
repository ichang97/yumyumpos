# พอร์ตและที่เก็บไฟล์ SQLite สำหรับโหมด Local / Docker
PORT=8787
HOST=0.0.0.0
DB_PATH=/app/data/yumyum-pos.sqlite

# โหมด Auth ใน Local / วง LAN (ค่าเริ่มต้น: ปิด Cloudflare Access เพื่อให้ใช้งานในร้านได้ทันที)
LOCAL_AUTH_MODE=off
LOCAL_USER_EMAIL=local@yumyum.pos
LOCAL_USER_ADMIN=true
ADMIN_EMAILS=

# หากเปิดใช้งานหลัง Reverse Proxy (Nginx / Traefik / Cloudflare Tunnel) ให้ตั้งเป็น true
TRUST_PROXY=true

# ถ้าต้องการบังคับตรวจ Cloudflare Access JWT แม้รันบน Docker ให้กรอกค่าทั้งสองด้านล่าง
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_AUD=your-access-aud-tag
