{
  "name": "yumyum-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply yumyum-pos-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yumyum-pos-db --remote",
    "test": "node scripts/verify-worker.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.5",
    "hono": "^4.7.0",
    "lucide-vue-next": "^0.475.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "wrangler": "^4.20.0"
  }
}
